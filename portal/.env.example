# Copy to .env.local and fill in. Never commit real values.

# Entra sign-in (Auth.js)
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Encrypts stored provider tokens. 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# GitHub connection mode: "app" (GitHub App, default) or "oauth" (classic OAuth App).
# GITHUB_CLIENT_ID/SECRET must belong to an app of that kind. Changing the mode asks users to reconnect.
GITHUB_AUTH_MODE=app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Atlassian OAuth 2.0 (3LO)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Optional: space-separated scopes. Default is read-only granular scopes (see lib/providers/jira.ts).
ATLASSIAN_SCOPES=

# Public origin of the portal (used for OAuth callback URLs). Set on the deployed app;
# locally the request host is used.
AUTH_URL=
