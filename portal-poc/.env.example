# Copy to .env.local and fill in. Never commit real values.

# Entra sign-in (Auth.js)
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Encrypts stored provider tokens. 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# GitHub App (user-to-server OAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Atlassian OAuth 2.0 (3LO)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Public origin of the portal (used for OAuth callback URLs). Set on the deployed app;
# locally the request host is used.
AUTH_URL=
